{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sashakang/ai-workspace/core-aiws/contracts/plugin-contract.schema.json",
  "title": "AI Workspace Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plugin_id",
    "version",
    "public_skills",
    "public_agents",
    "dependencies",
    "project_memory_read_scope",
    "project_memory_write_scope",
    "shared_memory_read_scope",
    "shared_memory_write_scope",
    "improve_targets"
  ],
  "properties": {
    "plugin_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "public_skills": {
      "type": "array",
      "description": "Plugin-exposed skills. In v1 this field name is retained for compatibility and does not imply internet-public visibility.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "public_agents": {
      "type": "array",
      "description": "Plugin-exposed agents. In v1 this field name is retained for compatibility and does not imply internet-public visibility.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "connectors": {
      "type": "array",
      "description": "Host-managed or MCP-backed external service connectors declared by the plugin.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "required",
          "capabilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "project_memory_read_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "project_memory_write_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shared_memory_read_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shared_memory_write_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "improve_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
